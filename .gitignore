# --- Copyrighted ROM data — NEVER commit. Supply your own via `make rom`. ---
games/*/rom/*.bin
games/*/rom/*.zip
# MAME romsets live here too, as a directory named for the driver
# (games/<id>/rom/<driver>/), so `-rompath games/<id>/rom` resolves them.
games/*/rom/*/

# --- Copyrighted AUDIO — NEVER commit. Recorded from YOUR ROM on YOUR machine
#     by games/<game>/tools/record_samples.py (see that dir's README-samples.md).
#     Same posture as the ROM data above: the repo ships the tool, not the sound.
games/*/audio/samples/

# --- Game SCREENSHOTS are COMMITTED (fair use — one small representative shot per
#     game, produced by tools/screenshot.py). This is a deliberate carve-out from
#     the raw-graphics rule above; do NOT commit full sprite/tile sheets or raw
#     frames. See runbook §5 "Ship a representative screenshot."

# --- Build & capture artifacts ---
out/
**/golden/**/*.rgb
**/golden/**/*.bin
games/*/tools/.golden-*/
*.avi

# --- Tooling ---
node_modules/
__pycache__/
*.pyc

# --- OS / editor cruft ---
.DS_Store
._*

# MAME writes this into its cwd when a tape uses the log notifier
tape.log

# local convenience symlink to the MAME source tree (BYO, machine-specific; agents read boards from it)
mame-src

# review-gate tokens (local enforcement state; see tools/review_gate.py)
.reviews/

# repo-root scratch space (agent mirrors, patches, renders). The few files already tracked
# under it stay tracked; only new, untracked work is ignored.
/scratchpad/

# pixel_gate_required romset waivers: local, single-use, bound to one staged diff
.pixelgate-waivers/
